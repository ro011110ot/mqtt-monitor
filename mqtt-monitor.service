[Unit]
Description=MQTT host monitor (CPU, RAM, temperatures, network)

[Service]
Type=simple
WorkingDirectory=%h/_scripts/mqtt_monitor
ExecStart=/usr/bin/uv run --frozen python main.py
Environment=PYTHONUNBUFFERED=1
# Optional overrides (better: systemctl --user edit mqtt-monitor), e.g.:
# Environment=MONITOR_INTERVAL=10
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
