# Copy this file to secrets.env and fill in your values:
#   cp secrets.example.env secrets.env && chmod 600 secrets.env
# secrets.env is ignored by git. Real environment variables take precedence.

# Required: hostname or IP address of the MQTT broker
MQTT_BROKER=mqtt.example.com

# Optional (defaults shown)
MQTT_PORT=1883
MQTT_CLIENT_ID=Manjaro
MQTT_TOPIC=host/monitor
MONITOR_INTERVAL=5

# Optional: broker credentials (leave empty for anonymous access)
MQTT_USERNAME=
MQTT_PASSWORD=
